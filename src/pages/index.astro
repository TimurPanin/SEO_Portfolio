---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageUrl = new URL('/', Astro.site).href;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SEO-портфолио Тимура Панина',
  url: pageUrl,
};
---

<BaseLayout
  title="SEO-портфолио — главная"
  description="Портфолио SEO-специалиста: техническое SEO, семантика, архитектура сайта, исследования и автоматизация."
>
  <h1>SEO-портфолио</h1>
  <p>Здесь будут представлены кейсы, исследования и подход к работе над поисковой оптимизацией.</p>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
</BaseLayout>
