---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageUrl = new URL('/about/', Astro.site).href;
const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  mainEntity: {
    '@type': 'Person',
    name: 'Тимур Панин',
    url: pageUrl,
  },
};
---

<BaseLayout
  title="Обо мне - SEO-портфолио"
  description="Страница о специалисте и направлениях работы: техническое SEO, семантика, оптимизация страниц и архитектура."
>
  <div class="secondary-page">
    <header class="secondary-hero">
      <h1>Обо мне</h1>
      <p>Провожу технические SEO-аудиты и проверяю выводы по данным страниц, HTML и HTTP-ответам.</p>
    </header>

    <div class="secondary-grid">
      <section class="secondary-panel" aria-labelledby="about-directions-title">
        <h2 id="about-directions-title">Направления работы</h2>
        <ul class="secondary-list">
          <li>Техническое SEO</li>
          <li>Семантические исследования</li>
          <li>Оптимизация страниц</li>
          <li>Архитектура сайта</li>
          <li>Структурированные данные</li>
        </ul>
      </section>
      <section class="secondary-panel" aria-labelledby="about-approach-title">
        <h2 id="about-approach-title">Подход к аудиту</h2>
        <p>Опыт веб-разработки помогает проверять HTML, HTTP-ответы и структуру страниц. В опубликованных аудитах я вручную перепроверяю автоматические сигналы и структурированные данные. Подтверждённые находки отделяю от контрольных проверок, а рекомендации - от результатов внедрения.</p>
        <a class="button button--secondary" href="/cases/">Посмотреть работы</a>
      </section>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
</BaseLayout>
