---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Контакты - SEO-портфолио"
  description="Связаться с Тимуром Паниным по вопросам SEO-аудита через Telegram."
>
  <div class="secondary-page">
    <header class="secondary-hero">
      <h1>Контакты</h1>
      <p>Для связи используйте Telegram.</p>
    </header>

    <section class="secondary-panel" aria-labelledby="contact-state-title">
      <h2 id="contact-state-title">Telegram</h2>
      <p>Напишите в Telegram: <a href="https://t.me/OBB1k">@OBB1k</a>.</p>
      <div class="secondary-actions">
        <a class="button button--primary" href="/cases/">Смотреть кейсы</a>
        <a class="button button--secondary" href="/about/">Обо мне</a>
      </div>
    </section>
  </div>
</BaseLayout>
