---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const homeUrl = new URL('/', Astro.site).href;
const casesUrl = new URL('/cases/', Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Кейсы', item: casesUrl },
    { '@type': 'ListItem', position: 3, name: 'Talisman Online', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Talisman Online — кейс SEO-портфолио"
  description="Страница кейса Talisman Online. Описание задачи, методики и подтверждённых материалов будет добавлено позже."
>
  <nav class="breadcrumbs" aria-label="Хлебные крошки">
    <ol>
      <li><a href="/">Главная</a></li>
      <li><a href="/cases/">Кейсы</a></li>
      <li aria-current="page">Talisman Online</li>
    </ol>
  </nav>
  <h1>Talisman Online</h1>
  <p>Описание задачи, методики работы и проверенных материалов по проекту будет добавлено позже.</p>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
