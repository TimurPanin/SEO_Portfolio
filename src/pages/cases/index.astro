---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout
  title="Кейсы — SEO-портфолио"
  description="Раздел кейсов SEO-портфолио: задачи, методика и подтверждённые материалы по проектам."
>
  <h1>Кейсы</h1>
  <p>В этом разделе будут опубликованы материалы по реальным проектам после проверки исходных данных.</p>
  <ul>
    {cases.map((entry) => (
      <li><a href={`/cases/${entry.id}/`}>{entry.data.title}</a></li>
    ))}
  </ul>
</BaseLayout>
