---
import { getCollection } from 'astro:content';
import CaseCard from '../../components/CaseCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.id.localeCompare(b.id));
const previews: Record<string, { src: string }> = {
  gasprofservice: { src: '/images/cases/gasprofservice-home.webp' },
  'talisman-online': { src: '/images/cases/talisman-online-home.webp' },
};
---

<BaseLayout
  title="SEO-кейсы и технические аудиты - Тимур Панин"
  description="Публичные SEO-аудиты и образцы работ Тимура Панина: подтверждённые технические находки, методика проверки, рекомендации и ограничения."
>
  <header class="cases-hero">
    <p class="home-eyebrow">Кейсы</p>
    <h1>SEO-аудиты и примеры работ</h1>
    <p>Публичные образцы работ с подтверждёнными находками, методикой проверки, рекомендациями и явно указанными ограничениями.</p>
  </header>

  <p class="cases-note">Все опубликованные материалы относятся к формату «Образец работы». Рекомендации не считаются внедрёнными, если это отдельно не подтверждено.</p>

  <section class="cases-list" aria-labelledby="cases-list-title">
    <h2 id="cases-list-title">Публичные аудиты</h2>
    <div class="case-grid">
      {cases.map((entry) => (
        <CaseCard
          title={entry.data.title}
          summary={entry.data.summary}
          status={entry.data.status}
          category={entry.data.category}
          href={`/cases/${entry.id}/`}
          preview={previews[entry.id]}
        />
      ))}
    </div>
  </section>

  <section class="cases-inside" aria-labelledby="cases-inside-title">
    <h2 id="cases-inside-title">Что есть внутри кейсов</h2>
    <div class="cases-inside__grid">
      <div>
        <h3>Методика проверки</h3>
        <p>Какие данные и инструменты использовались.</p>
      </div>
      <div>
        <h3>Подтверждённые находки</h3>
        <p>Только проблемы, которые удалось перепроверить.</p>
      </div>
      <div>
        <h3>Контрольные проверки</h3>
        <p>Примеры сигналов, которые не стали итоговыми ошибками.</p>
      </div>
      <div>
        <h3>Ограничения и рекомендации</h3>
        <p>Границы выводов и предлагаемые направления исправления.</p>
      </div>
    </div>
  </section>

  <section class="cases-cta" aria-labelledby="cases-cta-title">
    <div>
      <h2 id="cases-cta-title">Как проводится аудит</h2>
      <p>В каждом образце работы автоматические сигналы отделяются от подтверждённых проблем, а рекомендации - от фактического результата внедрения.</p>
    </div>
    <a class="button button--primary" href="/about/">О подходе</a>
  </section>
</BaseLayout>
