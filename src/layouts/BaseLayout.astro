---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: 'index, follow' | 'noindex, follow';
  includeCanonical?: boolean;
}

const { title, description, robots = 'index, follow', includeCanonical = true } = Astro.props;
const canonical = includeCanonical ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', label: 'Главная' },
  { href: '/cases/', label: 'Кейсы' },
  { href: '/research/', label: 'Исследования' },
  { href: '/lab/', label: 'SEO-лаборатория' },
  { href: '/about/', label: 'Обо мне' },
  { href: '/contact/', label: 'Контакты' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:title" content={title} />}
    {canonical && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:type" content="website" />}
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:site_name" content="SEO-портфолио Тимура Панина" />}
    {canonical && <meta property="og:locale" content="ru_RU" />}
    {canonical && <meta name="twitter:card" content="summary" />}
    {canonical && <meta name="twitter:title" content={title} />}
    {canonical && <meta name="twitter:description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <header class="site-header">
      <div class="site-header__inner container">
        <a class="site-brand" href="/" aria-label="Тимур Панин - главная">
          <span class="site-brand__name">Тимур Панин</span>
          <span class="site-brand__description">Портфолио SEO-специалиста</span>
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          <ul>
            {navigation.map(({ href, label }) => (
              <li><a href={href} class:list={{ 'is-active': href === '/' ? pathname === '/' : pathname.startsWith(href) }} aria-current={pathname === href ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button button--primary site-header__cta" href="/contact/">Контакты</a>
        <details class="mobile-nav">
          <summary>Меню</summary>
          <nav aria-label="Мобильная навигация">
            <ul>
              {navigation.map(({ href, label }) => (
                <li><a href={href} class:list={{ 'is-active': href === '/' ? pathname === '/' : pathname.startsWith(href) }} aria-current={pathname === href ? 'page' : undefined}>{label}</a></li>
              ))}
            </ul>
            <a class="button button--primary" href="/contact/">Контакты</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner container">
        <div>
          <p class="site-footer__name">Тимур Панин</p>
          <p class="site-footer__description">Портфолио SEO-специалиста</p>
        </div>
        <nav aria-label="Навигация в подвале">
          <ul>
            {navigation.filter(({ href }) => href !== '/').map(({ href, label }) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
