---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: 'index, follow' | 'noindex, follow';
  includeCanonical?: boolean;
}

const { title, description, robots = 'index, follow', includeCanonical = true } = Astro.props;
const canonical = includeCanonical ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:title" content={title} />}
    {canonical && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:type" content="website" />}
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <meta property="og:site_name" content="SEO-портфолио Тимура Панина" />}
    {canonical && <meta property="og:locale" content="ru_RU" />}
    {canonical && <meta name="twitter:card" content="summary" />}
    {canonical && <meta name="twitter:title" content={title} />}
    {canonical && <meta name="twitter:description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main">К основному содержимому</a>
    <header class="site-header">
      <nav aria-label="Основная навигация">
        <ul>
          <li><a href="/">Главная</a></li>
          <li><a href="/cases/">Кейсы</a></li>
          <li><a href="/research/">Исследования</a></li>
          <li><a href="/lab/">SEO Lab</a></li>
          <li><a href="/about/">Обо мне</a></li>
          <li><a href="/contact/">Контакты</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>SEO-портфолио</p>
    </footer>
  </body>
</html>
