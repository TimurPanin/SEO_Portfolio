---
interface Props {
  title: string;
  summary?: string;
  status?: 'work-sample' | 'case-study';
  category?: string;
  href: string;
  preview?: { src: string };
}

const { title, summary, status, category, href, preview } = Astro.props;
const statusLabel = status === 'work-sample' ? 'Образец работы' : status === 'case-study' ? 'Кейс с результатом' : undefined;
const categoryLabel = category === 'Technical SEO' ? 'Техническое SEO' : undefined;
---

<article class:list={['case-card card', { 'case-card--image': !!preview }]} style={preview && `--case-card-image: url("${preview.src}")`}>
  {(categoryLabel || statusLabel) && (
    <div class="case-card__labels">
      {categoryLabel && <span class="badge">{categoryLabel}</span>}
      {statusLabel && <span class="badge">{statusLabel}</span>}
    </div>
  )}
  <h3>{title}</h3>
  {summary && <p>{summary}</p>}
  <div class="case-card__actions">
    <a class="case-card__link" href={href}>Смотреть кейс: {title} <span aria-hidden="true">→</span></a>
  </div>
</article>
